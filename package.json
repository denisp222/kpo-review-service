{
  "name": "kpo-review-service",
  "version": "0.1.1",
  "private": true,
  "description": "Учебный модуль проверки работ: КПО, лабораторная №5",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "quality": "node scripts/quality.mjs",
    "metrics": "node scripts/metrics.mjs",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "9.39.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.0",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
